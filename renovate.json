{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommitsDisabled"
  ],
  "timezone": "Europe/Prague",
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 5,
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Docker images referenced in workflow env variables",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "TRIVY_IMAGE: (?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Home Assistant images of the contract tests",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "HA_IMAGE_(?:CURRENT|PREVIOUS): (?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "uv version used in CI",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["UV_VERSION: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "astral-sh/uv",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Keep uv versions (CI + Dockerfile) in one PR",
      "matchPackageNames": ["astral-sh/uv", "ghcr.io/astral-sh/uv"],
      "groupName": "uv"
    },
    {
      "description": "HA_IMAGE_PREVIOUS trails the current release: bump it by hand when HA_IMAGE_CURRENT moves to a new monthly release",
      "matchPackageNames": ["homeassistant/home-assistant"],
      "matchUpdateTypes": ["major", "minor"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Major updates of the data stack need a manual look (DuckLake catalog format)",
      "matchPackageNames": ["duckdb", "sqlmesh", "dagster", "chrislusf/seaweedfs", "postgres"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Our own images (compose defaults): each deployment pins them in .env, not Renovate",
      "matchPackageNames": ["ghcr.io/zettabyte-cz/**"],
      "enabled": false
    },
    {
      "description": "Python base image: a new major/minor (3.13 -> 3.15) needs the dependencies to support it first",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["python"],
      "matchUpdateTypes": ["major", "minor"],
      "dependencyDashboardApproval": true
    }
  ]
}
