#!/bin/sh
# Prints the environment of the HAmmond services (sourced by every s6 service):
# generated secrets from /data/secrets.env and the add-on options from
# /data/options.json. Run by `. hammond-env`.
set -eu
SECRETS=/data/secrets.env
OPTIONS=/data/options.json

opt() { # KEY DEFAULT
  python3 -c 'import json,sys
try: v = json.load(open(sys.argv[1])).get(sys.argv[2])
except FileNotFoundError: v = None
print(sys.argv[3] if v in (None, "") else v)' "$OPTIONS" "$1" "$2"
}

set -a
. "$SECRETS"
PGHOST=127.0.0.1
HAMMOND_EDITION=lite
HAMMOND_ACCESS_MODE=local
HAMMOND_LAKE_DATA_PATH=/data/lake
HAMMOND_LAKE_PG_HOST=127.0.0.1
HAMMOND_LAKE_PG_DB=ducklake
HAMMOND_LAKE_PG_USER=ducklake
HAMMOND_LAKE_PG_PASSWORD=$DUCKLAKE_PG_PASSWORD
HAMMOND_OPS_PG_HOST=127.0.0.1
HAMMOND_OPS_PG_USER=hammond_ops
HAMMOND_OPS_PG_PASSWORD=$OPS_PG_PASSWORD
HAMMOND_SQLMESH_PG_DB=sqlmesh
HAMMOND_WORKER_PG_DB=ops
HAMMOND_ANALYSIS_SETTINGS_DB=audit
HAMMOND_AUDIT_PG_HOST=127.0.0.1
HAMMOND_AUDIT_PG_DB=audit
# Home Assistant through the Supervisor proxy, with the add-on's own token.
HAMMOND_HA_URL=http://supervisor/core
HAMMOND_HA_TOKEN=${SUPERVISOR_TOKEN:-}
HAMMOND_TIMEZONE=${TZ:-UTC}
HAMMOND_LOG_LEVEL=$(opt log_level info | tr '[:lower:]' '[:upper:]')
HAMMOND_STATES_RETENTION_DAYS=$(opt states_retention_days 90)
HAMMOND_STATISTICS_5MIN_RETENTION_DAYS=$(opt statistics_5min_retention_days 90)
HAMMOND_STATISTICS_HOUR_RETENTION_DAYS=$(opt statistics_hour_retention_days 1825)
HAMMOND_MCP_URL=$(opt mcp_url "")
HAMMOND_DUCKDB_THREADS=2
HAMMOND_DUCKDB_TEMP_DIR=/data/duckdb-tmp
HAMMOND_DUCKDB_MAX_TEMP_SIZE=8GB
set +a
