#!/bin/sh
# Roles and databases (idempotent, the same script as compose) and the DuckLake catalog.
set -eu
. /usr/local/bin/hammond-env
i=0
until pg_isready -q -h 127.0.0.1; do
  i=$((i + 1))
  [ "$i" -lt 60 ] || { echo "Postgres did not start" >&2; exit 1; }
  sleep 1
done
PGPASSWORD=$POSTGRES_PASSWORD \
DUCKLAKE_DB=ducklake DUCKLAKE_USER=ducklake DUCKLAKE_PASSWORD=$DUCKLAKE_PG_PASSWORD \
OPS_USER=hammond_ops OPS_PASSWORD=$OPS_PG_PASSWORD DAGSTER_DB=dagster SQLMESH_DB=sqlmesh \
OPS_DB=ops AUDIT_DB=audit AUDIT_USER=hammond_audit AUDIT_PASSWORD=$AUDIT_PG_PASSWORD \
AUDIT_ADMIN_USER=hammond_audit_admin AUDIT_ADMIN_PASSWORD=$AUDIT_ADMIN_PG_PASSWORD \
  sh /usr/local/lib/hammond/ensure-databases.sh
s6-setuidgid hammond python -m hacore.lake init
