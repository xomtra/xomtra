#!/bin/sh
# Admin GUI in the Home Assistant sidebar (Ingress, ADR 070): HA signs the user in,
# only the Supervisor's proxy may connect.
. /usr/local/bin/hammond-env
cd /data/home
export HOME=/data/home HAMMOND_HOST=0.0.0.0 HAMMOND_ADMIN_PORT=8100 \
  HAMMOND_AUTH_MODE=ingress HAMMOND_DAGSTER_UI=false \
  HAMMOND_AUDIT_ADMIN_USER=hammond_audit_admin \
  HAMMOND_AUDIT_ADMIN_PASSWORD=$AUDIT_ADMIN_PG_PASSWORD \
  HAMMOND_DUCKDB_MEMORY_LIMIT=256MB HAMMOND_DUCKDB_THREADS=1
exec s6-setuidgid hammond hammond-admin
