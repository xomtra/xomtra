#!/bin/sh
# Postgres listens on the loopback only: nothing outside the add-on reaches it.
# Errors are logged without their statement: DuckLake retries a commit whose snapshot id
# another writer took (an ERROR in Postgres), and the statement would put Home Assistant
# data (attributes, names, addresses) into the add-on log.
exec s6-setuidgid postgres postgres -D /data/postgres \
  -c listen_addresses=127.0.0.1 -c shared_buffers=64MB -c max_connections=40 \
  -c log_destination=stderr -c logging_collector=off \
  -c log_min_error_statement=panic
