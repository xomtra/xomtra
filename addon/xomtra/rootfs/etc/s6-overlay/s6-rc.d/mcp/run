#!/bin/sh
# MCP server for the LAN with personal access tokens (ADR 056, 059).
. /usr/local/bin/xomtra-env
cd /data/home
export HOME=/data/home FASTMCP_HOME=/data/home/fastmcp \
  XOMTRA_HOST=0.0.0.0 XOMTRA_PORT=8000 XOMTRA_AUTH_MODE=ha \
  XOMTRA_AUDIT_PG_USER=xomtra_audit XOMTRA_AUDIT_PG_PASSWORD=$AUDIT_PG_PASSWORD \
  XOMTRA_DUCKDB_MEMORY_LIMIT=768MB
exec s6-setuidgid xomtra xomtra-mcp
