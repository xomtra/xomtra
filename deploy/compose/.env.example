# Copy to .env (ignored by git) and fill in. Generate secrets e.g. with:
#   openssl rand -hex 32
# Never commit the filled-in file.

COMPOSE_PROJECT_NAME=hammond

# Image of the MCP server. For deployments use a signed digest from GHCR:
#   ghcr.io/zettabyte-cz/hammond-mcp@sha256:...
HAMMOND_MCP_IMAGE=ghcr.io/zettabyte-cz/hammond-mcp:main
# Address the MCP server is published on. Keep 127.0.0.1 and put a reverse proxy
# (Caddy / Tailscale Funnel) in front of it.
HAMMOND_MCP_BIND=127.0.0.1
HAMMOND_MCP_PORT=8000

# --- Postgres (DuckLake catalog) ------------------------------------------------
POSTGRES_PASSWORD=change-me
DUCKLAKE_PG_DB=ducklake
DUCKLAKE_PG_USER=ducklake
DUCKLAKE_PG_PASSWORD=change-me

# --- SeaweedFS (S3) -------------------------------------------------------------
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=hammond

# --- MCP server / Entra ID (see docs/setup/entra-app-registration.md) -------------
# entra = OAuth proxy to Entra ID; none = no auth (only for local dev on loopback)
HAMMOND_AUTH_MODE=entra
# Public HTTPS URL under which Claude reaches the server (no trailing slash)
HAMMOND_BASE_URL=https://mcp.example.org
HAMMOND_ENTRA_TENANT_ID=
HAMMOND_ENTRA_CLIENT_ID=
HAMMOND_ENTRA_CLIENT_SECRET=
HAMMOND_ENTRA_REQUIRED_SCOPES=mcp.access
# >= 32 characters, stable across restarts
HAMMOND_JWT_SIGNING_KEY=

# --- Home Assistant (optional in phase 1a.1) -------------------------------------
# Long-lived access token of a dedicated, non-admin HA user.
HAMMOND_HA_URL=
HAMMOND_HA_TOKEN=
