# Copy to .env (ignored by git) and fill in. Generate secrets e.g. with:
#   openssl rand -hex 32
# Never commit the filled-in file.

COMPOSE_PROJECT_NAME=hammond

# Images. For deployments use the pinned lines from hammond-<version>-images.env of the
# release (tag@digest, signature verified), see docs/releasing.md.
HAMMOND_MCP_IMAGE=ghcr.io/zettabyte-cz/hammond-mcp:0.1.0
HAMMOND_CADDY_IMAGE=ghcr.io/zettabyte-cz/hammond-caddy:0.1.0
HAMMOND_INGEST_IMAGE=ghcr.io/zettabyte-cz/hammond-ingest:0.1.0

# --- Public entry (Caddy, see docs/setup/claude-connector.md) -------------------
# Public DNS name (Cloudflare zone) and HTTPS URL of the server.
HAMMOND_PUBLIC_HOST=mcp.example.org
ACME_EMAIL=admin@example.org
# Cloudflare API token: Zone -> DNS -> Edit, limited to this one zone.
CLOUDFLARE_API_TOKEN=
# Space separated CIDRs that Claude's servers connect from (Anthropic docs).
CLAUDE_IP_RANGES=
# Space separated CIDRs allowed to open the admin GUI and Dagster UI under /admin
# (the network of your admin machine, not the whole LAN), see docs/setup/admin-gui.md.
ADMIN_CIDR=
# Host address Caddy listens on (the VM's DMZ address or 0.0.0.0).
HAMMOND_HTTPS_BIND=0.0.0.0

# --- Postgres (DuckLake catalog, Dagster and SQLMesh state) -----------------------
POSTGRES_PASSWORD=change-me
DUCKLAKE_PG_DB=ducklake
DUCKLAKE_PG_USER=ducklake
DUCKLAKE_PG_PASSWORD=change-me
# Role owning the Dagster and SQLMesh state databases (created by postgres-init).
OPS_PG_USER=hammond_ops
OPS_PG_PASSWORD=change-me
DAGSTER_PG_DB=dagster
SQLMESH_PG_DB=sqlmesh
# Audit of MCP tool calls (database and INSERT-only role created by postgres-init).
AUDIT_PG_DB=audit
AUDIT_PG_USER=hammond_audit
AUDIT_PG_PASSWORD=change-me
# Admin GUI: reads the audit (SELECT + INSERT).
AUDIT_ADMIN_PG_USER=hammond_audit_admin
AUDIT_ADMIN_PG_PASSWORD=change-me
# Days of MCP audit kept (0 = keep everything); older records are purged once a day.
AUDIT_RETENTION_DAYS=90

# --- SeaweedFS (S3) -------------------------------------------------------------
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=hammond

# --- MCP server / Entra ID (see docs/setup/entra-app-registration.md) -------------
# entra = OAuth proxy to Entra ID; none = no auth (only for local dev on loopback)
HAMMOND_AUTH_MODE=entra
# Must be https://${HAMMOND_PUBLIC_HOST} (no trailing slash)
HAMMOND_BASE_URL=https://mcp.example.org
HAMMOND_ENTRA_TENANT_ID=
HAMMOND_ENTRA_CLIENT_ID=
HAMMOND_ENTRA_CLIENT_SECRET=
HAMMOND_ENTRA_REQUIRED_SCOPES=mcp.access
# >= 32 characters, stable across restarts
HAMMOND_JWT_SIGNING_KEY=
# Signs the admin GUI session cookie: >= 32 characters (openssl rand -hex 32).
HAMMOND_ADMIN_SESSION_KEY=
# Access policy per Entra app role (default: built-in policy.yaml, ADR 038). To adapt it,
# mount a file into the mcp container and point this variable at it.
HAMMOND_POLICY_FILE=
# query_sql / get_timeseries: time limit per call, DuckDB memory and container cap.
HAMMOND_QUERY_TIMEOUT_SECONDS=30
HAMMOND_MCP_DUCKDB_MEMORY_LIMIT=768MB
HAMMOND_MCP_MEM_LIMIT=1536m

# --- Home Assistant ----------------------------------------------------------------
# Long-lived access token of a dedicated, non-admin HA user (read access is enough:
# registries, history and statistics). Used by the MCP server and the ingest.
HAMMOND_HA_URL=
HAMMOND_HA_TOKEN=

# --- Ingest (see docs/setup/ingest.md) ----------------------------------------------
# Rows older than this are deleted from bronze and silver by the daily retention job:
# states, 5-minute statistics, hourly statistics (ADR 034).
HAMMOND_STATES_RETENTION_DAYS=365
HAMMOND_STATISTICS_5MIN_RETENTION_DAYS=365
HAMMOND_STATISTICS_HOUR_RETENTION_DAYS=1825
# Memory: DuckDB budget per process (spills to disk beyond it) and container caps.
# Defaults fit a VM with 8 GB RAM; keep HAMMOND_DAGSTER_MEM_LIMIT >= memory limit + 1 GB.
HAMMOND_DUCKDB_MEMORY_LIMIT=2GB
HAMMOND_DUCKDB_THREADS=2
HAMMOND_DUCKDB_MAX_TEMP_SIZE=8GB
HAMMOND_DAGSTER_MEM_LIMIT=3g
# Time zone of the Dagster schedules (hourly ingest, retention 03:30, catalog 04:15)
# and of daily buckets in get_timeseries.
HAMMOND_TIMEZONE=UTC
# Dagster UI fallback: published on this host address only (keep loopback, SSH tunnel to
# http://127.0.0.1:3000/admin/dagster/). Normal access: https://<public-host>/admin/dagster/
HAMMOND_DAGSTER_BIND=127.0.0.1
